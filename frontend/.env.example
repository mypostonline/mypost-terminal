VITE_API_URL=http://localhost:3000
VITE_API_TIMEOUT_MS=15000
# Адрес мобильного приложения, в котором пользователь открывает свой заказ.
VITE_APP_URL=http://localhost:5173
VITE_CASH_BILL_PATH_TEMPLATE=/orders/{orderId}/cash/bills
VITE_CASH_BALANCE_CREDIT_PATH_TEMPLATE=/orders/{orderId}/cash/credit
# Оба POST-маршрута должны поддерживать Idempotency-Key.
# Фиксация купюры получает cash_session_id, bill_id, sequence, amount, accepted_at.
# Зачисление частичной суммы получает cash_session_id, amount и bills.
VITE_MQTT_URL=ws://mqtt.my-post.online:8080

VITE_PROPERTY_ID=1
VITE_POST_ID=1
VITE_QR_SRC=/assets/tmp/107.svg
# Время бездействия до возврата на главный экран, в секундах.
VITE_INACTIVITY=60

# card,cash — оба устройства; card — только карта; cash — только наличные.
VITE_PAYMENT_METHODS=card,cash
