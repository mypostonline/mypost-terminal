PORT=3001
CORS_ORIGIN=http://localhost:5173

# vendotek — реальное устройство; mock — тестовая оплата без оборудования.
CARD_TERMINAL_ENABLED=true
CARD_TERMINAL_DRIVER=vendotek
VTK_HOST=192.168.1.1
VTK_PORT=62801
PAYMENT_WAIT_SEC=60

# gpio-pulse — Raspberry Pi + gpiomon; mock — тестовые купюры без оборудования.
BILL_ACCEPTOR_ENABLED=false
BILL_ACCEPTOR_DRIVER=gpio-pulse
BILL_ACCEPTOR_GPIO_CHIP=gpiochip0
BILL_ACCEPTOR_GPIO_LINE=17
BILL_ACCEPTOR_RUB_PER_PULSE=50
BILL_ACCEPTOR_DEBOUNCE_MS=70
BILL_ACCEPTOR_PACKET_GAP_MS=1200
BILL_ACCEPTOR_MAX_PACKET_TIME_MS=3000
BILL_ACCEPTOR_VALID_AMOUNTS=50,100,500,1000
BILL_ACCEPTOR_GPIOMON_COMMAND=gpiomon

CASH_PAYMENT_TIMEOUT_SEC=300

# Public mobile/web URL opened after scanning the change QR.
# Use {token} where the signed claim should be inserted.
CASH_CHANGE_CREDIT_URL_TEMPLATE=https://app.example.com/cash-change?token={token}
CASH_CHANGE_TOKEN_SECRET=replace-with-a-long-random-secret
CASH_CHANGE_TOKEN_TTL_SEC=86400

DEBUG=false
